<!-- Background of the static widget-picker preview only (layout/widget_beacons_preview.xml,
     the android:previewLayout in xml/widget_beacons_info.xml). The live Glance widget does not
     draw this drawable; it sets its own background and corner radius in BeaconsWidgetProvider.kt.
     This preview keeps its own palette, hairline and radius on purpose. The app's cards are
     12dp (Acab.radius, ui/theme/Theme.kt). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#161214" />
    <corners android:radius="18dp" />
    <stroke android:width="1dp" android:color="#26EC968C" />
</shape>
