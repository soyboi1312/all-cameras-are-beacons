<!-- Home-screen widget surface: the Acab dark card, matching bg2 (#161214) with the same
     hairline crimson-tinted border the in-app panels use, so the widget reads as one piece
     with the app. Corner radius mirrors Acab.radius (18dp). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#161214" />
    <corners android:radius="18dp" />
    <stroke android:width="1dp" android:color="#26EC968C" />
</shape>
