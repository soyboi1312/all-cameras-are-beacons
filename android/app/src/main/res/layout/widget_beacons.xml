<!-- Glanceable home-screen widget, ported from the iOS DetectionsWidget anatomy (R19):
     wordmark + link dot, today's count with its kicker, a six-cell per-category strip, and a
     last-hit line carrying the category's own glyph and tint. Colors are the Acab palette
     hardcoded as hex (a RemoteViews layout can't pull the Compose theme). Dynamic bits (count,
     strip counts + visibility, last line glyph/tint/text, the link dot) are filled in
     BeaconsWidgetProvider.buildViews.

     The strip is a FIXED six cells in WidgetCategory order (alpr, drone, body, tracker, glasses,
     camera), so each cell's glyph and tint are baked in here and the provider only sets the
     number and GONE/VISIBLE. Zero-count cells are hidden, so a quiet day collapses the strip
     the way the iOS medium widget does. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="14dp">

    <!-- Header: wordmark (lowercase brand rule) + link state on the right. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="beacons"
            android:textColor="#F4EEF0"
            android:textSize="14sp"
            android:fontFamily="@font/space_grotesk_bold" />

        <!-- Crimson dot + dim-white "connected", dim dot + "not connected" when not.
             Crimson, not teal: teal is the tracker category's tone, and a link indicator wearing
             a category colour reads as a detection. -->
        <TextView
            android:id="@+id/widget_dot"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="●"
            android:textSize="9sp"
            android:textColor="#EE4034"
            android:layout_marginEnd="5dp" />

        <TextView
            android:id="@+id/widget_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="connected"
            android:textColor="#99F0E0E2"
            android:textSize="9sp"
            android:letterSpacing="0.08"
            android:fontFamily="@font/jetbrains_mono_bold" />
    </LinearLayout>

    <!-- Today's running count, the headline number. -->
    <TextView
        android:id="@+id/widget_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="0"
        android:textColor="#F4EEF0"
        android:textSize="34sp"
        android:includeFontPadding="false"
        android:fontFamily="@font/space_grotesk_bold" />

    <TextView
        android:id="@+id/widget_today"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="today"
        android:textColor="#EE4034"
        android:textSize="9sp"
        android:letterSpacing="0.1"
        android:fontFamily="@font/jetbrains_mono_bold" />

    <!-- Per-category strip: glyph + count, non-zero cells only. -->
    <LinearLayout
        android:id="@+id/widget_strip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <LinearLayout
            android:id="@+id/widget_c0"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginEnd="10dp">
            <ImageView
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:src="@drawable/ic_w_alpr"
                android:contentDescription="alpr"
                android:tint="#EE4034" />
            <TextView
                android:id="@+id/widget_c0_n"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="3dp"
                android:text="0"
                android:textColor="#EAF4EEF0"
                android:textSize="11sp"
                android:fontFamily="@font/jetbrains_mono_medium" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_c1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginEnd="10dp">
            <ImageView
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:src="@drawable/ic_w_drone"
                android:contentDescription="drone"
                android:tint="#F2B53C" />
            <TextView
                android:id="@+id/widget_c1_n"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="3dp"
                android:text="0"
                android:textColor="#EAF4EEF0"
                android:textSize="11sp"
                android:fontFamily="@font/jetbrains_mono_medium" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_c2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginEnd="10dp">
            <ImageView
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:src="@drawable/ic_w_body"
                android:contentDescription="body cam"
                android:tint="#CDC1C3" />
            <TextView
                android:id="@+id/widget_c2_n"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="3dp"
                android:text="0"
                android:textColor="#EAF4EEF0"
                android:textSize="11sp"
                android:fontFamily="@font/jetbrains_mono_medium" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_c3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginEnd="10dp">
            <ImageView
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:src="@drawable/ic_w_tracker"
                android:contentDescription="tracker"
                android:tint="#49C5B1" />
            <TextView
                android:id="@+id/widget_c3_n"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="3dp"
                android:text="0"
                android:textColor="#EAF4EEF0"
                android:textSize="11sp"
                android:fontFamily="@font/jetbrains_mono_medium" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_c4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginEnd="10dp">
            <ImageView
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:src="@drawable/ic_w_glasses"
                android:contentDescription="glasses"
                android:tint="#B07CFF" />
            <TextView
                android:id="@+id/widget_c4_n"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="3dp"
                android:text="0"
                android:textColor="#EAF4EEF0"
                android:textSize="11sp"
                android:fontFamily="@font/jetbrains_mono_medium" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_c5"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <ImageView
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:src="@drawable/ic_w_netcam"
                android:contentDescription="network camera"
                android:tint="#4AA8FF" />
            <TextView
                android:id="@+id/widget_c5_n"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="3dp"
                android:text="0"
                android:textColor="#EAF4EEF0"
                android:textSize="11sp"
                android:fontFamily="@font/jetbrains_mono_medium" />
        </LinearLayout>
    </LinearLayout>

    <!-- Spacer pushes the last-seen line to the bottom edge. FrameLayout, NOT View: RemoteViews
         only inflates an allowlisted set of classes and a bare View is not in it, so the widget
         threw at inflate time on some launchers. FrameLayout is allowlisted and an empty weighted
         one is the same spacer. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Last hit: category glyph + "alpr - 3m ago". Empty state is the green check-shield with
         "no detections" / "not connected". Glyph resource and tint are set at render. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/widget_last_icon"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginEnd="5dp"
            android:src="@drawable/ic_w_ok"
            android:contentDescription="@null"
            android:tint="#5AD08A" />

        <TextView
            android:id="@+id/widget_last"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="no detections"
            android:textColor="#8CF0E0E2"
            android:textSize="11sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:fontFamily="@font/jetbrains_mono_medium" />
    </LinearLayout>
</LinearLayout>
