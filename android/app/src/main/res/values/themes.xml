<resources>
    <!-- Minimal host theme; Compose draws the actual UI. Dark window + bars so
         there is no light flash before the first frame. #1A1112 mirrors the palette's
         `surface` (AcabPalette in ui/theme/Theme.kt), the same at both contrast levels.
         The two bar colours only cover that cold-start frame: MainActivity.onCreate calls
         enableEdgeToEdge, which makes both bars transparent (and Android 15+ ignores these
         items anyway), so from the first Compose frame on the app draws under the bars. -->
    <style name="Theme.OuiAcab" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">#1A1112</item>
        <item name="android:statusBarColor">#1A1112</item>
        <item name="android:navigationBarColor">#1A1112</item>
    </style>
</resources>
